# Copy into Streamlit Cloud -> App settings -> Secrets (never commit real keys).
# One LLM key is enough. Gemini and Groq both have free tiers.
GEMINI_API_KEY = "your-gemini-key"      # https://aistudio.google.com/apikey
# GROQ_API_KEY = "your-groq-key"        # https://console.groq.com/keys
# TAVILY_API_KEY = "your-tavily-key"    # optional: "Discover" web sources + web research
# LLM_PROVIDER = "gemini"               # optional: force gemini | groq | openai | ollama
# GEMINI_MODEL = "gemini-3.8-flash"
